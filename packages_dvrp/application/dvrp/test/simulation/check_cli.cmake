cmake_minimum_required(VERSION 3.15)
function(expect code pattern)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if (NOT "${result}" STREQUAL "${code}")
        message(FATAL_ERROR "expected exit ${code}, got ${result}: ${ARGN}\n${output}\n${error}")
    endif ()
    if (NOT "${output}\n${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "missing ${pattern}: ${ARGN}\n${output}\n${error}")
    endif ()
    if (NOT "${code}" STREQUAL "0" AND output MATCHES "SUMMARY status=Completed")
        message(FATAL_ERROR "failed command reported completion")
    endif ()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
set(file "${FIXTURES}/three_events.txt")
set(options --branching rf --pricing bucket)
if (CASE STREQUAL "success")
    foreach (branch rf arc)
        foreach (pricing plain bucket)
            expect(0 "SUMMARY status=Completed.*actual_distance=28.*served=3" "${file}" --branching ${branch} --pricing ${pricing})
            foreach (pattern "INPUT .*customers=3" "RUN branching=${branch} pricing=${pricing}" "STAGE id=2 .*time=15" "operation=finish")
                if (NOT last_output MATCHES "${pattern}")
                    message(FATAL_ERROR "missing ${pattern}")
                endif ()
            endforeach ()
        endforeach ()
    endforeach ()
elseif (CASE STREQUAL "help")
    expect(0 "Usage: dvrp_solve" --help)
    if (last_output MATCHES "(^|\n)(STAGE|INPUT|RUN) ")
        message(FATAL_ERROR "help tried to run a simulation")
    endif ()
elseif (CASE STREQUAL "arguments")
    expect(2 "required")
    expect(2 "required" "${file}")
    expect(2 "required" "${file}" --branching rf)
    expect(2 "required" "${file}" --pricing bucket)
    expect(2 "exactly one" "${file}" "${file}" ${options})
    expect(2 "unknown option" "${file}" ${options} -u 28)
    expect(2 "unknown option" "${file}" ${options} --help)
    expect(2 "duplicate option" "${file}" ${options} --branching arc)
    expect(2 "missing value" "${file}" ${options} --stage-seconds)
    expect(2 "must be rf or arc" "${file}" --branching q --pricing bucket)
    expect(2 "must be plain or bucket" "${file}" --branching rf --pricing bidirectional)
    foreach (value -1 NaN inf 1x 1e999 " ")
        expect(2 "finite nonnegative" "${file}" ${options} --stage-seconds "${value}")
    endforeach ()
    foreach (value -1 1.5 1x 184467440737095516160)
        expect(2 "nonnegative integer" "${file}" ${options} --max-nodes "${value}")
    endforeach ()
elseif (CASE STREQUAL "input")
    expect(1 "not_here" "${FIXTURES}/not_here.txt" ${options})
    expect(1 "numeric fields" "${READER_FIXTURES}/invalid_missing_disclosure.txt" ${options})
elseif (CASE STREQUAL "infeasible")
    expect(3 "SUMMARY status=StoppedInfeasible.*complete=false" "${FIXTURES}/infeasible.txt" ${options})
elseif (CASE STREQUAL "limits")
    expect(4 "SUMMARY status=StoppedTimeLimit.*actual_distance=0" "${file}" ${options} --stage-seconds 0)
    expect(5 "status=NodeLimit" "${file}" ${options} --max-nodes 0)
else ()
    message(FATAL_ERROR "unknown CLI case ${CASE}")
endif ()
